# Скопируйте в .env (cp .env.example .env) и поправьте при необходимости.
# Все переменные необязательны: без .env всё запустится с настройками по умолчанию.

# Порт сайта на вашем компьютере
WEB_PORT=8080

# Администратор для /admin/ (создаётся при первом запуске)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please

# Секретный ключ Django. Пусто — сгенерируется автоматически
DJANGO_SECRET_KEY=

# Разрешённые адреса. Если открываете сайт из интернета — укажите домен или IP через запятую
DJANGO_ALLOWED_HOSTS=*
# Для админки по домену с https, например: https://it.example.com
CSRF_TRUSTED_ORIGINS=

# Уведомления в Telegram (необязательно)
TELEGRAM_BOT_TOKEN=
